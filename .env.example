# PostgreSQL connection (database and user must already exist, see readme)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/DNBot-DB?schema=public"

# WhatsApp groups the bot monitors (comma-separated)
GROUP_NAMES=Pipa Digital Nomads, Testes
# Group (one of GROUP_NAMES) that receives the daily tide/astronomy/wave messages
MAIN_GROUP_NAME=Pipa Digital Nomads

# Feature flags: true/false. Unset = default shown below.
# FF_ALL=false turns off every feature at once (the bot only stays connected)
FF_ALL=true
# Keyword auto-replies in groups (keywords.json)
FF_KEYWORD_RESPONSES=true
# Welcome message for new group members
FF_WELCOME_MESSAGE=true
# Natal / Recife / João Pessoa ride-share scan in groups and the !natal, !recife, !jp boards
FF_CITY_TRANSFER=true
# Taxi / mototaxi / transfer requests via private messages
FF_TAXI=true
# Driver self-registration via private messages
FF_DRIVER_REGISTRATION=true
# Daily tide message (04:00) and the midnight tide data fetch
FF_TIDE_DAILY=true
# Daily sun/moon message (04:01)
FF_ASTRONOMY_DAILY=true
# Daily wave/surf message (19:30)
FF_WAVE_DAILY=false

# OpenRouter API key (for Natal/city transfer message parsing)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OpenRouter model to use (optional, defaults to google/gemini-3.1-flash-lite)
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# APIVerve API key (for astronomical data: sunrise/sunset, moonrise/moonset, moon phase)
APIVERVE_API_KEY=YourAPIVerveKey
# StormGlass API key (for tide data)
STORMGLASS_API_KEY=YourStormGlass.io-APIKey

# Optional: daily log files directory (default: ./logs/console-logs)
# LOG_DIRECTORY=/var/log/pipa-dn-bot/console-logs
# Optional: WhatsApp session directory (default: ./auth_info)
# AUTH_DIR=/path/to/auth_info

# Note: Driver contacts are managed in the database (drivers table)
# Use scripts/migrate-drivers-to-db.js to migrate existing contacts
